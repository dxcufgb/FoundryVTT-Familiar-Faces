<div class="dxff-sheet-scroll">
  {{#if missing}}
  <div class="dxff-empty">
    <i class="fa-solid fa-ghost" inert></i>
    <p>{{goneText}}</p>
  </div>
  {{else}}
  <section class="dxff-profile">
    {{> "modules/dxcufgbs-familiar-faces/templates/portrait.hbs"}}

    <div class="dxff-profile-body">
      {{#if editing}}
      <form class="dxff-face-edit" autocomplete="off">
        <div class="form-group stacked">
          <label>{{localize "DXFF.Field.Name"}}</label>
          <input type="text" data-bind="draft.name" value="{{draft.name}}" maxlength="80" required>
        </div>
        <div class="form-group stacked">
          <label>{{localize "DXFF.Field.MetAt"}}</label>
          <div class="dxff-with-btn">
            <input type="text" data-bind="draft.metAt" value="{{draft.metAt}}" list="{{appId}}-places" maxlength="120"
                   placeholder="{{localize "DXFF.Placeholder.MetAt"}}">
            {{#if currentScene}}
            <button type="button" class="dxff-icon-btn" data-action="useScene" data-scope="draft" data-field="metAt"
                    data-tooltip="{{localize "DXFF.UseScene" scene=currentScene}}"><i class="fa-solid fa-map-location-dot" inert></i></button>
            {{/if}}
          </div>
        </div>
        <div class="form-group stacked">
          <label>{{localize "DXFF.Field.Info"}}</label>
          <textarea data-bind="draft.info" rows="5" data-drop="text" placeholder="{{localize "DXFF.Placeholder.Info"}}">{{draft.info}}</textarea>
          <p class="dxff-hint">{{localize "DXFF.InfoHint"}}</p>
        </div>
        <footer class="dxff-form-footer">
          <button type="button" data-action="cancelEdit"><i class="fa-solid fa-xmark" inert></i> {{localize "DXFF.Cancel"}}</button>
          <button type="submit" class="dxff-primary"><i class="fa-solid fa-check" inert></i> {{localize "DXFF.Save"}}</button>
        </footer>
      </form>
      {{else}}
      <h2 class="dxff-name">{{entry.name}}</h2>
      <dl class="dxff-facts">
        {{#if entry.metAt}}
        <div><dt><i class="fa-solid fa-location-dot" inert></i> {{localize "DXFF.Field.MetAt"}}</dt>
          <dd>{{#if metAtPlaceId}}<a class="dxff-link" data-action="openPlace" data-place-id="{{metAtPlaceId}}"
                data-tooltip="DXFF.OpenPlace">{{entry.metAt}}</a>{{else}}{{entry.metAt}}{{/if}}</dd></div>
        {{/if}}
        {{#if sourceHTML}}
        <div><dt><i class="fa-solid fa-book-open" inert></i> {{localize "DXFF.Source"}}</dt><dd>{{{sourceHTML}}}</dd></div>
        {{/if}}
        <div><dt><i class="fa-solid fa-calendar-plus" inert></i> {{localize "DXFF.AddedOn"}}</dt><dd>{{added}}{{#if addedBy}} · {{addedBy}}{{/if}}</dd></div>
        {{#if knownBy}}
        <div><dt><i class="fa-solid fa-user-lock" inert></i> {{localize "DXFF.KnownByLabel"}}</dt><dd>{{knownBy}}</dd></div>
        {{/if}}
      </dl>
      {{#if infoHTML}}<div class="dxff-info">{{{infoHTML}}}</div>{{/if}}
      {{#if hasActions}}
      <div class="dxff-profile-actions">
        {{#if canEdit}}<button type="button" data-action="editFace"><i class="fa-solid fa-pen" inert></i> {{localize "DXFF.Edit"}}</button>{{/if}}
        {{#if canShare}}<button type="button" data-action="shareFace" data-tooltip="{{texts.shareHint}}"><i class="fa-solid fa-users" inert></i> {{texts.share}}</button>{{/if}}
        {{#if canForget}}<button type="button" class="dxff-danger" data-action="forgetFace"><i class="{{texts.forgetIcon}}" inert></i> {{texts.forget}}</button>{{/if}}
        {{#if canDelete}}<button type="button" class="dxff-danger" data-action="deleteFace"><i class="fa-solid fa-trash" inert></i> {{texts.remove}}</button>{{/if}}
      </div>
      {{/if}}
      {{/if}}
    </div>
  </section>

  <datalist id="{{appId}}-places">
    {{#each placeOptions}}<option value="{{this}}"></option>{{/each}}
  </datalist>

  {{#if showPlaces}}
  <section class="dxff-links">
    <header class="dxff-links-header">
      <h3><i class="fa-solid fa-map-location-dot" inert></i> {{localize "DXFF.PlacesOfFace"}}</h3>
      {{#if canLinkPlace}}
      <button type="button" class="dxff-icon-btn" data-action="linkPlace" data-tooltip="DXFF.LinkPlaceHint"
              aria-label="{{localize "DXFF.LinkPlace"}}"><i class="fa-solid fa-link" inert></i></button>
      {{/if}}
    </header>
    <ul class="dxff-link-list">
      {{#each linkedPlaces}}
      <li class="dxff-link-item" data-place-id="{{id}}">
        <button type="button" class="dxff-link-open" data-action="openPlace" data-tooltip="{{why}}">
          <span class="dxff-avatar dxff-square" style="--hue: {{hue}}">{{#if img}}<img src="{{img}}" alt="" loading="lazy">{{else}}<span>{{initials}}</span>{{/if}}</span>
          <span class="dxff-link-name">{{name}}</span>
        </button>
        {{#if canUnlink}}
        <button type="button" class="dxff-icon-btn dxff-danger" data-action="unlinkPlace" data-tooltip="DXFF.Unlink"
                aria-label="{{localize "DXFF.Unlink"}}"><i class="fa-solid fa-link-slash" inert></i></button>
        {{/if}}
      </li>
      {{else}}
      <li class="dxff-no-notes">{{localize "DXFF.NoPlacesOfFace"}}</li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  {{> "modules/dxcufgbs-familiar-faces/templates/notes.hbs"}}
  {{/if}}
</div>
